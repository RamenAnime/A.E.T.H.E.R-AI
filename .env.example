# A.E.T.H.E.R. configuration (copy to .env)

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=HBr48ROZd1B2dv74C8bN

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CODE_MODEL=codellama:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# DeepSeek cloud LLM (optional). See integrations/deepseek/README.md
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CODE_MODEL=deepseek-coder
# ollama | deepseek | hybrid (defaults to hybrid when DEEPSEEK_API_KEY is set)
LLM_BACKEND=hybrid

USE_AIRLLM=false
AIRLLM_QUANTIZATION=int4
AIRLLM_CACHE_DIR=./models

AETHER_DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/vector_db

ALLOWED_ROOTS=~/Desktop,~/Documents,~/Projects
MAX_FILE_SIZE=10485760

REQUIRE_PERMISSIONS=true
PERMISSION_TIMEOUT=30

# Ender 3 V3 (default profile)
PRINTER_PROFILE=ender3_v3
PRINTER_TYPE=octoprint
OCTOPRINT_URL=http://192.168.1.50:5000
OCTOPRINT_API_KEY=your_octoprint_api_key

# If you use Klipper + Moonraker instead:
# PRINTER_TYPE=moonraker
# MOONRAKER_URL=http://192.168.1.50:7125
# MOONRAKER_API_KEY=

# Web server (use 0.0.0.0 via: aether web --lan)
AETHER_WEB_PORT=8787

# Persona / A.E.T.H.E.R. assistant
AETHER_PERSONA=aether          # aether | neutral
AETHER_ASSISTANT_NAME=A.E.T.H.E.R.
AETHER_USER_TITLE=sir          # how the AI addresses you (sir, boss, your name)
AETHER_WAKE_WORD=aether        # hands-free wake word

# Where engineered apps/backends are written
AETHER_BUILD_DIR=./data/builds

# Smart home (local Home Assistant). Create a long-lived token in HA profile.
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=

# Offline voice input (Vosk) for the desktop app. Download a model, then point here.
# AETHER_VOSK_MODEL=./models/vosk
