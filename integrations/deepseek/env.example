# DeepSeek cloud LLM (copy these lines into your project .env)

# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional overrides
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CODE_MODEL=deepseek-coder

# How A.E.T.H.E.R. chooses brains:
#   ollama   - local only (default when no API key)
#   deepseek - cloud only (Ollama still needed for embeddings / fallback tooling)
#   hybrid   - DeepSeek for chat/code/research; Ollama fallback if cloud fails
LLM_BACKEND=hybrid
